# Configure only in Render Dashboard > Environment. Never commit real credentials.
SPEECHMATICS_API_KEY=
PORT=10000
ALLOWED_ORIGIN=*
MAX_UPLOAD_MB=250
# TopAi Auto Face Center limits. The server deletes the uploaded source copy and extracted frames after every request.
MAX_TRACK_SECONDS=60
MAX_TRACK_FRAMES=96
TRACK_TIMEOUT_MS=240000
